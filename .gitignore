*.pyc

# Bases de datos locales (el backend las crea y siembra al arrancar)
*.db
*.db-shm
*.db-wal

# Binarios de release (publicar en GitHub Releases, no en el repo)
*.apk
*.aab

# Secretos y configuración local
.env
.env.*
!.env.example
*.pem
*.key
*.keystore
*.jks
