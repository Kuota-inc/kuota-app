# Variables de la app (se leen al compilar). Copia lo que necesites a frontend/.env.android (APK) o frontend/.env.local (web).
# Estos archivos no se versionan.

# Backend al que habla la app. Producción: https://<dominio>/api/v1 · Tu PC en la misma Wi-Fi: http://<ip-de-tu-pc>:3001/api/v1
VITE_API_BASE=http://localhost:3001/api/v1

# WhatsApp oficial de soporte: solo dígitos con código de país (p. ej. 51999999999). Si falta se usa uno provisional.
VITE_SUPPORT_WHATSAPP=

# Comisión que muestra la app (%). Debe coincidir con KUOTA_FEE_BPS del backend; si falta, 1.
VITE_FEE_PCT=1

# Solo para compilar un APK que hable con tu PC por HTTP (http, sin HTTPS). NUNCA entregues ese APK.
# Uso: KUOTA_DEV_LAN=1 npm run apk
