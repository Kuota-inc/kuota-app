<?xml version="1.0" encoding="utf-8"?>
<!-- Política de red de Kuota: solo HTTPS y solo certificados del sistema (no los instalados por el usuario). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
