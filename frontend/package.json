    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^14.9.0",
    "lucide-react": "^1.66.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
