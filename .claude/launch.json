{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "kuota-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort",
        "--host"
      ],
      "port": 5173
    },
    {
      "name": "kuota-backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "backend",
        "run",
        "dev"
      ],
      "port": 3001
    },
    {
      "name": "pay360-local",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "backend",
        "run",
        "pay360:mock"
      ],
      "port": 3360
    },
    {
      "name": "didit-local",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "backend",
        "run",
        "didit:mock"
      ],
      "port": 3370
    }
  ]
}
