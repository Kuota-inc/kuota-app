  "cards": [
    {
      "dot": "amber",
      "title": "Frontera de Confianza No Confiable",
      "items": [
        "El cliente movil y web interactuan con Express 5 mediante Bearer tokens y endpoints publicos",
        "Google Play Integrity opera con politica fail-open si falta PLAY_INTEGRITY_API_KEY en produccion"
      ]
    },
    {
      "dot": "rose",
      "title": "Aislamiento de Persistencia",
      "items": [
        "paymentsDb recurre a DATABASE_URL si PAYMENTS_DATABASE_URL no esta provista en el entorno",
        "El esquema payments almacena ledger, webhook_events, rate limits y auditoria HMAC"
      ]
    },
    {
      "dot": "emerald",
      "title": "Integraciones Externas",
      "items": [
        "360Pay valida webhooks entrantes con firma HMAC-SHA256 y ventana temporal de 300 segundos",
        "Didit cuenta con limite diario en tabla didit_session_log para evitar agotamiento de presupuesto"
      ]
    }
  ]
