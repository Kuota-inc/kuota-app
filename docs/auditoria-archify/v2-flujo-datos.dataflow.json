{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "Kuota - Flujo de Datos, Clasificacion y Persistencia",
    "quality_profile": "showcase",
    "output": "docs/auditoria-archify/v2-flujo-datos.html",
    "viewBox": [1080, 520],
    "views": [
      {
        "id": "auth-flow",
        "label": "Flujo de Identidad y Credenciales",
        "focus": ["client_device", "api_ingress", "auth_engine", "db_core", "merchant_ui"],
        "note": "Ruta de credenciales PIN, desafios biometricos ECDSA P-256 y tokens JWT."
      },
      {
        "id": "payment-ledger-flow",
        "label": "Riel de Pagos y Asientos Contables",
        "focus": ["payer_source", "webhook_ingress", "ledger_engine", "db_vault", "settlement_rail"],
        "note": "Procesamiento de pagos recibidos, deduplicacion por webhook y registro en partida doble."
      },
      {
        "id": "audit-immutability",
        "label": "Cadena de Auditoria HMAC y Verificacion",
        "focus": ["ledger_engine", "audit_engine", "db_audit", "audit_monitor"],
        "note": "Encadenamiento criptografico de eventos financieros con anclajes periodicos."
      }
    ]
  },
  "stages": [
    { "label": "Fuentes" },
    { "label": "Ingesta" },
    { "label": "Procesamiento" },
    { "label": "Almacenamiento" },
    { "label": "Consumo" }
  ],
  "nodes": [
    {
      "id": "client_device",
      "type": "frontend",
      "label": "App Movil Kuota",
      "sublabel": "KeyStore / P256",
      "stage": 0,
      "row": 0,
      "tag": "Credenciales"
    },
    {
      "id": "payer_source",
      "type": "external",
      "label": "Pagador Yape/BCP",
      "sublabel": "Canal Pagador",
      "stage": 0,
      "row": 1,
      "tag": "Soles / Voucher"
    },
    {
      "id": "didit_source",
      "type": "external",
      "label": "Didit Verifier",
      "sublabel": "OCR y Liveness",
      "stage": 0,
      "row": 2,
      "tag": "KYC Datos"
    },
    {
      "id": "api_ingress",
      "type": "backend",
      "label": "Express Ingress",
      "sublabel": "REST API :3000",
      "stage": 1,
      "row": 0,
      "tag": "TLS 1.3"
    },
    {
      "id": "webhook_ingress",
      "type": "security",
      "label": "Webhook Ingress",
      "sublabel": "HMAC / Skew",
      "stage": 1,
      "row": 1,
      "tag": "Anti-Replay"
    },
    {
      "id": "auth_engine",
      "type": "security",
      "label": "Motor Acceso",
      "sublabel": "Bcrypt / ECDSA",
      "stage": 2,
      "row": 0,
      "tag": "Auth Guard"
    },
    {
      "id": "ledger_engine",
      "type": "backend",
      "label": "Motor Contable",
      "sublabel": "Doble Partida",
      "stage": 2,
      "row": 1,
      "tag": "Ledger Service"
    },
    {
      "id": "audit_engine",
      "type": "security",
      "label": "Motor Auditoria",
      "sublabel": "HMAC-SHA256 Dual",
      "stage": 2,
      "row": 2,
      "tag": "Hash Chain"
    },
    {
      "id": "db_core",
      "type": "database",
      "label": "PG Core",
      "sublabel": "Schema: public",
      "stage": 3,
      "row": 0,
      "brand": "postgresql",
      "tag": "PII Texto Claro"
    },
    {
      "id": "db_vault",
      "type": "database",
      "label": "PG Vault",
      "sublabel": "Schema: payments",
      "stage": 3,
      "row": 1,
      "brand": "postgresql",
      "tag": "Esquema payments"
    },
    {
      "id": "db_audit",
      "type": "database",
      "label": "Audit Anchors",
      "sublabel": "WORM Anchors",
      "stage": 3,
      "row": 2,
      "brand": "postgresql",
      "tag": "Append-Only"
    },
    {
      "id": "merchant_ui",
      "type": "frontend",
      "label": "UI Proveedor",
      "sublabel": "Conciliacion",
      "stage": 4,
      "row": 0,
      "tag": "Dashboard"
    },
    {
      "id": "settlement_rail",
      "type": "external",
      "label": "Riel Liquidacion",
      "sublabel": "360Pay Payouts",
      "stage": 4,
      "row": 1,
      "tag": "Pendiente Validar"
    },
    {
      "id": "audit_monitor",
      "type": "security",
      "label": "Audit Watcher",
      "sublabel": "Watcher Horario",
      "stage": 4,
      "row": 2,
      "tag": "Anti-Tamper"
    }
  ],
  "flows": [
    {
      "id": "flow-auth-req",
      "from": "client_device",
      "to": "api_ingress",
      "label": "PIN / Disp",
      "classification": "Credenciales",
      "variant": "emphasis"
    },
    {
      "id": "flow-pay-webhook",
      "from": "payer_source",
      "to": "webhook_ingress",
      "label": "Notifica Pago",
      "classification": "Monto S/",
      "variant": "emphasis",
      "route": "straight",
      "labelAt": [140, 195]
    },
    {
      "id": "flow-kyc-data",
      "from": "didit_source",
      "to": "webhook_ingress",
      "label": "Callback KYC",
      "classification": "OCR DNI",
      "variant": "security"
    },
    {
      "id": "flow-ingress-auth",
      "from": "api_ingress",
      "to": "auth_engine",
      "label": "Token Bearer",
      "classification": "Sesion",
      "variant": "security"
    },
    {
      "id": "flow-ingress-ledger",
      "from": "webhook_ingress",
      "to": "ledger_engine",
      "label": "Payload HMAC",
      "classification": "Transaccion",
      "variant": "emphasis"
    },
    {
      "id": "flow-auth-core",
      "from": "auth_engine",
      "to": "db_core",
      "label": "Guarda Sesion",
      "classification": "Tokens / PII",
      "variant": "default"
    },
    {
      "id": "flow-ledger-vault",
      "from": "ledger_engine",
      "to": "db_vault",
      "label": "Doble Partida",
      "classification": "Asientos S/",
      "variant": "emphasis"
    },
    {
      "id": "flow-ledger-audit",
      "from": "ledger_engine",
      "to": "audit_engine",
      "label": "Evento Ledger",
      "classification": "Audit Entry",
      "variant": "security",
      "fromSide": "bottom",
      "toSide": "top",
      "labelAt": [415, 295]
    },
    {
      "id": "flow-audit-db",
      "from": "audit_engine",
      "to": "db_audit",
      "label": "Bloque Hash",
      "classification": "HMAC-SHA256",
      "variant": "security"
    },
    {
      "id": "flow-core-ui",
      "from": "db_core",
      "to": "merchant_ui",
      "label": "Ventas / Saldo",
      "classification": "Dashboard",
      "variant": "default"
    },
    {
      "id": "flow-vault-settlement",
      "from": "db_vault",
      "to": "settlement_rail",
      "label": "Liquidacion",
      "classification": "Abono S/",
      "variant": "dashed"
    },
    {
      "id": "flow-audit-watcher",
      "from": "db_audit",
      "to": "audit_monitor",
      "label": "Audit Verify",
      "classification": "Hash Check",
      "variant": "security"
    }
  ],
  "cards": [
    {
      "dot": "amber",
      "title": "Datos Personales y PII en Reposo",
      "items": [
        "DNI, RUC, nombres y CCI se almacenan en texto claro en public.merchant_profiles",
        "Los hashes de PIN se derivan con bcrypt y pimienta fija en memoria del proceso"
      ]
    },
    {
      "dot": "rose",
      "title": "Aislamiento Financiero y Contabilidad",
      "items": [
        "El motor contable ejecuta balance de doble partida registrando activo, pasivo, comision e IGV",
        "El abono/payout a cuenta bancaria no cuenta con integracion automatizada demostrada"
      ]
    },
    {
      "dot": "emerald",
      "title": "Cadena de Auditoria Criptografica",
      "items": [
        "Audit log utiliza doble cadena: hash publico SHA-256 mas HMAC-SHA256 con llave privada",
        "Audit watcher verifica periodicamente la integridad de los bloques para detectar manipulacion"
      ]
    }
  ]
}