      "to": "audit_hash",
      "label": "cuadrado 100%",
      "variant": "emphasis"
    },
    {
      "id": "e_hash_seal",
      "from": "audit_hash",
      "to": "reconciled_seal",
      "label": "sellado criptografico",
      "variant": "default"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Motor de Conciliacion",
      "items": [
        "runReconciliation() contrasta movimientos del ledger de partida doble con reportes de 360Pay"
      ]
    },
    {
      "dot": "rose",
      "title": "Proteccion y Circuit Breaker",
      "items": [
        "Cualquier descalce no cuadrado activa el circuit breaker congelando payouts y preservando auditoria"
      ]
    }
