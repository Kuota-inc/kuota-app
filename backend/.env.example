# Kuota backend. Copia a backend/.env y completa (nunca subas el .env real).
# En desarrollo, si faltan los secretos, se generan en backend/.dev-secrets.json.
# En producción (NODE_ENV=production) son obligatorios: mínimo 32 caracteres.

PORT=3001
NODE_ENV=development

# Secretos (Secrets Manager / KMS en producción)
KUOTA_LINK_SIGNING_KEY=
KUOTA_WEBHOOK_SECRET=
KUOTA_SESSION_SECRET=
KUOTA_PIN_PEPPER=
KUOTA_ADMIN_TOKEN=

# Página pública de pago a la que apuntan links y QR
KUOTA_PAY_BASE_URL=http://localhost:5173/pay
# Orígenes permitidos por CORS, separados por comas (en desarrollo también la red local)
KUOTA_CORS_ORIGINS=http://localhost:5173,http://localhost,capacitor://localhost
# 1 si el backend está detrás de un proxy / API Gateway
KUOTA_TRUST_PROXY=0
# 0 desactiva el simulador de 360pay (siempre desactivado en producción)
KUOTA_SANDBOX=1

# Topes de 360pay (rige el más restrictivo con los de Kuota)
KUOTA_PARTNER_MAX_TX_CENTS=1000000
KUOTA_PARTNER_MAX_DAILY_CENTS=5000000
KUOTA_PARTNER_MAX_DAILY_COUNT=500

# PIN de la cuenta demo mer_carlos (solo fuera de producción); por defecto el del seed
KUOTA_DEMO_PIN=
