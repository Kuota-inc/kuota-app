# Kuota backend. Copia a backend/.env y completa (nunca subas el .env real).
# En desarrollo, si faltan los secretos, se generan en backend/.dev-secrets.json.
# En producción (NODE_ENV=production) son obligatorios: mínimo 32 caracteres.

PORT=3001
NODE_ENV=development

# Base de datos. Sin DATABASE_URL se usa PGlite (Postgres embebido) en KUOTA_PG_DATA.
# Producción: DATABASE_URL = usuario del núcleo; PAYMENTS_DATABASE_URL = usuario de pagos.
DATABASE_URL=
PAYMENTS_DATABASE_URL=
KUOTA_PG_DATA=.pgdata
# 0 en producción: las migraciones corren como paso del despliegue (npm run migrate)
KUOTA_AUTO_MIGRATE=1

# Secretos (Secrets Manager / KMS en producción)
KUOTA_LINK_SIGNING_KEY=
KUOTA_WEBHOOK_SECRET=
KUOTA_SESSION_SECRET=
KUOTA_PIN_PEPPER=
KUOTA_ADMIN_TOKEN=

# Página pública de pago a la que apuntan links y QR
KUOTA_PAY_BASE_URL=http://localhost:5173/pay
# Orígenes permitidos por CORS, separados por comas (en desarrollo también la red local)
KUOTA_CORS_ORIGINS=http://localhost:5173,http://localhost,capacitor://localhost
# 1 si el backend está detrás de un proxy / API Gateway
KUOTA_TRUST_PROXY=0
# 0 desactiva el simulador de 360pay (siempre desactivado en producción)
KUOTA_SANDBOX=1

# Topes de 360pay (rige el más restrictivo con los de Kuota)
KUOTA_PARTNER_MAX_TX_CENTS=1000000
KUOTA_PARTNER_MAX_DAILY_CENTS=5000000
KUOTA_PARTNER_MAX_DAILY_COUNT=500

# 360pay (https://api.360pay.pe/docs). Sin API key se usa el simulador local.
# La API key se crea en https://sandbox.console.360pay.pe/ (sandbox) o console.360pay.pe.
KUOTA_360PAY_API_KEY=
KUOTA_360PAY_BASE_URL=https://sandbox.api.360pay.pe/v1
# Hook PAYMENT_PAID: su id (X-360Pay-Hook-Id). Su signing_secret (whsec_…) va en KUOTA_WEBHOOK_SECRET.
KUOTA_360PAY_HOOK_ID=
# Prefijo del código de cliente en 360pay (confirmar con 360pay el formato esperado)
KUOTA_360PAY_CODE_PREFIX=KTA

# Datos de la empresa que muestran las páginas legales (/legal/privacidad, /legal/terminos, /reclamaciones)
KUOTA_COMPANY_NAME=
KUOTA_COMPANY_RUC=
KUOTA_COMPANY_ADDRESS=
KUOTA_CONTACT_EMAIL=

# Correo transaccional (copia del reclamo al cliente, alerta a operaciones y respuesta). Dos opciones:
#  a) SMTP con un buzón propio (p. ej. Hostinger): smtps://avisos%40kuota.pro:CLAVE@smtp.hostinger.com:465
#     (el @ del usuario y los símbolos de la clave van codificados en URL).
KUOTA_SMTP_URL=
#  b) Resend (https://resend.com), si no hay SMTP:
RESEND_API_KEY=
# Remitente, p. ej. Kuota <avisos@kuota.pro>. Sin proveedor configurado no se envía nada (queda en el log).
KUOTA_MAIL_FROM=
# A dónde llega cada reclamo nuevo y el resumen diario de vencimientos (si falta, se usa KUOTA_CONTACT_EMAIL)
KUOTA_COMPLAINTS_EMAIL=

# PIN de la cuenta demo mer_carlos (solo fuera de producción); por defecto el del seed
KUOTA_DEMO_PIN=

# Didit (KYC: documento + prueba de vida + rostro). Sin estas variables, modo demo (no en producción).
# Sandbox gratis con claves sk_test_…; docs: https://docs.didit.me
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_BASE_URL=https://verification.didit.me
DIDIT_WEBHOOK_SECRET=
# A dónde vuelve el usuario al terminar (deep link o página de la app)
DIDIT_CALLBACK_URL=

# Openpay (https://github.com/open-pay) — conformidad del enganche (Bloque 4).
# Sin estas variables el backend usa un cargo ficticio (sandbox local); el
# webhook POST /sandbox/openpay/pay simula la confirmación para pruebas.
# Claves de sandbox en: https://sandbox-dashboard.openpay.pe
# Claves de producción en: https://dashboard.openpay.pe
OPENPAY_MERCHANT_ID=
OPENPAY_PRIVATE_KEY=
# false = apunta a api.openpay.pe (producción); por defecto sandbox
OPENPAY_IS_SANDBOX=true

# --- Avanzadas ---
# Exigir el token de identidad del dispositivo en /merchants/me y /credit. Por defecto: obligatorio en producción,
# opcional en desarrollo (1 lo fuerza, 0 lo apaga en producción: no recomendado).
KUOTA_REQUIRE_MERCHANT_TOKEN=
# Máximo de conexiones del pool de Postgres (por defecto 10).
KUOTA_PG_POOL_MAX=
# Dónde guardar los secretos generados en desarrollo (por defecto backend/.dev-secrets.json).
KUOTA_DEV_SECRETS_FILE=
