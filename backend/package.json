{
  "name": "kuota-backend",
  "version": "1.1.0",
  "description": "Kuota Fintech Backend REST API v1 (Postgres)",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "start:dev": "tsx src/server.ts",
    "build": "tsc",
    "migrate": "tsx src/db/migrate-cli.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "pay360:mock": "tsx tools/pay360-mock.ts",
    "didit:mock": "tsx tools/didit-mock.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=22"
  }
}
